{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ErrorResponse",
  "type": "object",
  "properties": {
    "status": { "type": "integer" },
    "error": { "type": "string" },
    "message": { "type": "string" },
    "validationErrors": {
      "type": ["object", "null"],
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string" }
      }
    }
  },
  "required": ["status", "error", "message"],
  "additionalProperties": false
}