FROM maven:3.9.9-eclipse-temurin-21 AS build
WORKDIR /build

COPY pom.xml .
COPY app-backend/pom.xml app-backend/pom.xml
COPY testing-framework/pom.xml testing-framework/pom.xml
COPY app-backend/src app-backend/src
COPY testing-framework/src testing-framework/src

RUN mvn -pl app-backend -am clean package -DskipTests

FROM eclipse-temurin:21-jre
WORKDIR /app

COPY --from=build /build/app-backend/target/app-backend-1.0-SNAPSHOT.jar app.jar

EXPOSE 8080

ENTRYPOINT ["java", "-jar", "app.jar"]
